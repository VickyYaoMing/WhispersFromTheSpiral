--- !u!1001 &4758906952213014327
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 2371527867909937182}
    m_Modifications:
    - target: {fileID: 4613828026226185999, guid: 3b2842f6aeffbd24cac0d9e63051d100, type: 3}
      propertyPath: m_Text
      value: "October 13th 1969 \n\nThis one squirmed more than the others. I don't
        really see a reason for this, I explained everything clearly.\n\nAt the end
        of the day it might not understand me of course, being the creature it is.
        I must be getting closer.\n\nI can almost taste the progress, though I wish
        this putrid scent would leave me alone at least when I manage to finally
        get some sleep."
      objectReference: {fileID: 0}
    - target: {fileID: 7544921937658798171, guid: 3b2842f6aeffbd24cac0d9e63051d100, type: 3}
